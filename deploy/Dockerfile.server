FROM node:22-alpine AS build
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY server/package.json server/package.json
RUN pnpm install --frozen-lockfile
COPY server server
RUN pnpm --filter @genesis-soldier-soul/server build
RUN pnpm deploy --legacy --filter @genesis-soldier-soul/server --prod /release
COPY client-restored/Build/WebGL /release/public

FROM node:22-alpine
ENV NODE_ENV=production
ENV WEB_ROOT=/app/public
WORKDIR /app
COPY --from=build /release ./
USER node
EXPOSE 8080
CMD ["node", "dist/index.js"]
